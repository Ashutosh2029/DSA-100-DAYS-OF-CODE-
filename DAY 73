#include <iostream>
#include <vector>
using namespace std;

int main() {
    string s;
    cin >> s;

    vector<int> freq(26, 0);

    // Step 1: Count frequency
    for (char c : s) {
        freq[c - 'a']++;
    }

    // Step 2: Find first non-repeating
    for (char c : s) {
        if (freq[c - 'a'] == 1) {
            cout << c << endl;
            return 0;
        }
    }

    // If all characters repeat
    cout << '$' << endl;

    return 0;
}
