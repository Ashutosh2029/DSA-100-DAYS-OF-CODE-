#include <stdio.h>
#include <stdlib.h>

#define MAX 100

int queue[MAX];
int front = -1, rear = -1;

// Enqueue
void enqueue(int val) {
    if (rear == MAX - 1) return;

    if (front == -1) front = 0;
    queue[++rear] = val;
}

// Dequeue
int dequeue() {
    if (front == -1 || front > rear) return -1;
    return queue[front++];
}

// Check empty
int isEmpty() {
    return (front == -1 || front > rear);
}

// Stack for reversing
int stack[MAX];
int top = -1;

// Push
void push(int val) {
    stack[++top] = val;
}

// Pop
int pop() {
    return stack[top--];
}

// Main function
int main() {
    int n, val;

    scanf("%d", &n);

    // Input queue
    for (int i = 0; i < n; i++) {
        scanf("%d", &val);
        enqueue(val);
    }

    // Step 1: Move queue → stack
    while (!isEmpty()) {
        push(dequeue());
    }

    // Step 2: Move stack → queue
    front = 0;
    rear = -1;

    while (top != -1) {
        enqueue(pop());
    }

    // Print reversed queue
    for (int i = front; i <= rear; i++) {
        printf("%d ", queue[i]);
    }

    return 0;
}
