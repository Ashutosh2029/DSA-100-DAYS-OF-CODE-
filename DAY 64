#include <iostream>
#include <vector>
#include <queue>
using namespace std;

void bfs(int s, vector<vector<int>> &adj, int n) {
    vector<bool> visited(n, false);
    queue<int> q;

    // Start from source
    visited[s] = true;
    q.push(s);

    while (!q.empty()) {
        int node = q.front();
        q.pop();

        // Print node
        cout << node << " ";

        // Visit neighbors
        for (int neighbor : adj[node]) {
            if (!visited[neighbor]) {
                visited[neighbor] = true;
                q.push(neighbor);
            }
        }
    }
}

int main() {
    int n;
    cin >> n;  // number of vertices

    vector<vector<int>> adj(n);

    // Input adjacency list
    for (int i = 0; i < n; i++) {
        int m; // number of neighbors
        cin >> m;
        for (int j = 0; j < m; j++) {
            int x;
            cin >> x;
            adj[i].push_back(x);
        }
    }

    int s;
    cin >> s; // source vertex

    bfs(s, adj, n);

    return 0;
}
