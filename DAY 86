#include <stdio.h>

int main() {
    long long n;
    scanf("%lld", &n);

    long long left = 0, right = n, ans = 0;

    while (left <= right) {
        long long mid = left + (right - left) / 2;

        if (mid * mid <= n) {
            ans = mid;        // mid is a valid candidate
            left = mid + 1;   // try for a larger value
        } else {
            right = mid - 1;  // reduce the search space
        }
    }

    printf("%lld\n", ans);

    return 0;
}
