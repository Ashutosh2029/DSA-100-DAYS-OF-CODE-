#include <stdlib.h>

// Comparator for sorting
int compare(const void* a, const void* b) {
    return (*(int*)a - *(int*)b);
}

int* twoSumClosestZero(int* nums, int numsSize, int* returnSize) {
    qsort(nums, numsSize, sizeof(int), compare);

    int left = 0, right = numsSize - 1;
    int minSum = 2147483647;  // INT_MAX
    int* result = (int*)malloc(2 * sizeof(int));

    while(left < right) {
        int sum = nums[left] + nums[right];

        if(abs(sum) < abs(minSum)) {
            minSum = sum;
            result[0] = nums[left];
            result[1] = nums[right];
        }

        if(sum < 0) {
            left++;
        } else {
            right--;
        }
    }

    *returnSize = 2;
    return result;
}
