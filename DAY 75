#include <iostream>
#include <unordered_map>
using namespace std;

int main() {
    int n;
    cin >> n;

    int arr[n];
    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    unordered_map<int, int> mp; // prefix_sum -> first index
    int sum = 0, maxLen = 0;

    for (int i = 0; i < n; i++) {
        sum += arr[i];

        // If sum becomes 0 → whole array till i
        if (sum == 0) {
            maxLen = i + 1;
        }

        // If sum seen before
        if (mp.find(sum) != mp.end()) {
            maxLen = max(maxLen, i - mp[sum]);
        } else {
            mp[sum] = i; // store first occurrence
        }
    }

    cout << maxLen << endl;

    return 0;
}
